# DeepSeek 大模型配置（OpenAI 兼容接口）
DEEPSEEK_API_KEY=请填写你的APIKey
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=0.7

# RAG 配置
# Embedding：本地 Jina 中文模型（fastembed / ONNX，不依赖 torch）
EMBEDDING_MODEL_NAME=jinaai/jina-embeddings-v2-base-zh
# 国内访问 HuggingFace 受限，模型下载走 hf-mirror 镜像
HF_ENDPOINT=https://hf-mirror.com
# 镜像不支持 Xet 存储后端，需禁用（否则模型下载 401 报错）
HF_HUB_DISABLE_XET=1
# ONNX 推理线程数（4 线程约 4GB 内存，勿贪大）
EMBEDDING_THREADS=4
EMBEDDING_BATCH_SIZE=128

# Rerank（可选：SiliconFlow 云端重排；不配 key 则跳过重排）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=3

# 知识库参数
CHUNK_SIZE=400
CHUNK_OVERLAP=80
RAG_TOP_K=6

# 问诊参数
MAX_INQUIRY_ROUNDS=3

# MySQL（可选：MYSQL_ENABLED=1 时启用用户注册/登录与历史持久化；不启用则用内存存储）
# 本地无 MySQL 时：cd docker && docker compose up -d mysql redis（容器映射到宿主 3307，避开 Windows 侧 MySQL）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=medical123456
MYSQL_DB=medical_assistant
MYSQL_ENABLED=1
